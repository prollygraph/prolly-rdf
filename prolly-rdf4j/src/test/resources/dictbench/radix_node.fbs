// Radix dictionary node, FlatBuffers-framed — the framing-leveled probe arm
// (matches the engine's flatbuffers 23.5.26 runtime; generated by flatc 23.5.26).
namespace com.earasoft.prolly.rdf4j.dictbench.fb;

table FbNode {
  is_bucket:bool;
  prefix:[ubyte];
  has_terminal:bool;
  terminal_id:long;
  // internal nodes:
  edge_bytes:[ubyte];       // n edge bytes, ascending
  children:[ubyte];         // n * 20 flattened child addresses
  // bucket nodes (n entries):
  bucket_offsets:[int];     // n+1 offsets into bucket_payload (suffix i = [off[i], off[i+1]))
  bucket_payload:[ubyte];
  bucket_ids:[long];
}
root_type FbNode;
